CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_RTC_CLK_SRC_INT_RC=y
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=y
# Retain the GPIO peripheral for explicit held OFF pads and GPIO wake.
CONFIG_PM_POWER_DOWN_PERIPHERAL_IN_LIGHT_SLEEP=n
# Each held OFF pin and both wake inputs explicitly opt out of sleep pin switching.
CONFIG_PM_SLP_DISABLE_GPIO=y
CONFIG_ESP_SLEEP_POWER_DOWN_FLASH=n
CONFIG_ESP_PHY_MAC_BB_PD=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y
CONFIG_MBEDTLS_CCM_C=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=n
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
CONFIG_COAP_MBEDTLS_PSK=y
CONFIG_COAP_MBEDTLS_PKI=n
CONFIG_COAP_SERVER_SUPPORT=y
CONFIG_COAP_CLIENT_SUPPORT=n
CONFIG_COAP_TCP_SUPPORT=n
CONFIG_COAP_WEBSOCKETS=n
CONFIG_COAP_PROXY_SUPPORT=n
CONFIG_COAP_OSCORE_SUPPORT=n
CONFIG_COAP_THREAD_SAFE=n
CONFIG_COAP_ASYNC_SUPPORT=n
CONFIG_COAP_DEBUGGING=n
CONFIG_LWIP_IPV4=y
CONFIG_LWIP_IPV6=n
CONFIG_NVS_ENCRYPTION=y
# Thread/BLE are absent from the selected dependency graph; STA only at runtime.
CONFIG_SB_WIFI_PLAINTEXT_DISPOSABLE_BENCH=n
