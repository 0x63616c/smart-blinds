(version 1)
(rule "Primary signal clearance" (constraint clearance (min 0.20mm)))
(rule "Primary copper to edge" (constraint edge_clearance (min 0.30mm)))
(rule "Primary minimum signal track" (constraint track_width (min 0.15mm)))
(rule "Primary hole to copper" (constraint hole_clearance (min 0.25mm)))
(rule "Primary via annular ring" (condition "A.Type == 'Via'") (constraint annular_width (min 0.15mm)))
