  (text
    "3S CHARGER / CIRCUIT STUDY"
    (at 15 17 0)
    (effects
      (font
        (size 2 2))
      (justify left))
    (uuid "e3ffe4f2-30bc-5c11-8621-5e9eea6db2c1"))
  (text
    "BQ25798: 3S, 750 kHz, 2.2 uH. Protected pack, USB-PD and logic regulator connect through named global nets."
    (at 15 26 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left))
    (uuid "da2decf5-9c40-5eae-8e1b-9374bf609659"))
  (text
    "All capacitor values are nominal. DC bias, converter dynamics and thermal behavior require qualification."
    (at 15 34 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left))
    (uuid "5794d042-7566-593b-b4ca-5205e1a1f1cc"))
  (text
    "Active-LOW charging permission; absent 3V3 keeps the CE pull-down off."
    (at 15 190 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left))
    (uuid "f4df082c-27a5-5a5a-9c58-e20a863e795f"))
  (text
    "NTC: independent 10k / B3435 thermistor on cells (external).\nHost sets 40C warm suspend; independent pack protection required.\nDefault hard-hot is approximately 60C, not 45C."
    (at 230 215 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left))
    (uuid "27d700f7-3241-5985-8c53-73f472d1a6c8"))
  (text
    "Motor uses protected PACK, not SYS.\nNo placement, routing, physical charging or fabrication approval."
    (at 230 240 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left))
    (uuid "143568a4-468e-5069-b68c-ead4ac84bf85"))
  (text
    "Integrated controller page. Native exported netlist checked against all PCB pins; unpowered and unrouted."
    (at 15 278 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left))
    (uuid "c4d1b80f-a28a-562a-9c9b-890a41c6b614")))
