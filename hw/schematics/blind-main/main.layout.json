  "pages": [
    {
      "id": "01-usb",
      "short_title": "USB-C input",
      "title": "Smart Blinds / USB-C input",
      "block_layout": "hw/schematics/blind-usb/usb-test.layout.json",
      "prefix": "usb",
      "source_prefix": "usb",
      "notes": [
        {
          "at": [
            15,
            15
          ],
          "text": "USB-C PD INPUT / CIRCUIT STUDY",
          "size": 2
        },
        {
          "at": [
            15,
            24
          ],
          "text": "Owned MCU I2C at 0x28; VSYS=3.3V. Factory access holds MCU reset, inhibits CE and isolates downstream USB load.",
          "size": 1.27
        },
        {
          "at": [
            15,
            33
          ],
          "text": "Source/load protection, discharge timing and startup remain unqualified. Charger input capacitor bank is external.",
          "size": 1.27
        },
        {
          "at": [
            15,
            281
          ],
          "text": "42-part source capture with upstream cutoff. Routing, factory access and physical qualification remain incomplete.",
          "size": 1.27
        }
      ]
    },
    {
      "id": "02-charger",
      "short_title": "3S charger",
      "title": "Smart Blinds / 3S charger",
      "block_layout": "hw/schematics/blind-charger/charger-test.layout.json",
      "prefix": "charger",
      "source_prefix": "charger",
      "notes": [
        {
          "at": [
            15,
            17
          ],
          "size": 2,
          "text": "3S CHARGER / CIRCUIT STUDY"
        },
        {
          "at": [
            15,
            26
          ],
          "text": "BQ25798: 3S, 750 kHz, 2.2 uH. Protected pack, USB-PD and logic regulator connect through named global nets."
        },
        {
          "at": [
            15,
            34
          ],
          "text": "All capacitor values are nominal. DC bias, converter dynamics and thermal behavior require qualification."
        },
        {
          "at": [
            15,
            190
          ],
          "text": "Active-LOW charging permission; absent 3V3 keeps the CE pull-down off."
        },
        {
          "at": [
            230,
            215
          ],
          "text": "NTC: independent 10k / B3435 thermistor on cells (external).\nHost sets 40C warm suspend; independent pack protection required.\nDefault hard-hot is approximately 60C, not 45C."
        },
        {
          "at": [
            230,
            240
          ],
          "text": "Motor uses protected PACK, not SYS.\nNo placement, routing, physical charging or fabrication approval."
        },
        {
          "at": [
            15,
            278
          ],
          "text": "Integrated controller page. Native exported netlist checked against all PCB pins; unpowered and unrouted."
        }
      ]
    },
    {
      "id": "03-logic",
      "short_title": "Logic supply",
      "title": "Smart Blinds / Logic supply",
      "block_layout": "hw/schematics/blind-regulator/regulator-test.layout.json",
      "prefix": "logic_supply",
      "source_prefix": "regulator",
      "notes": [
        {
          "at": [
            15,
            15
          ],
          "size": 2,
          "text": "3.3 V LOGIC SUPPLY / CIRCUIT STUDY"
        },
        {
          "at": [
            15,
            24
          ],
          "text": "TPS62902: charger SYS 8.8-13.2V input; 1A load design target. Internal 3.3V divider (VSET intentionally open)."
        },
        {
          "at": [
            15,
            33
          ],
          "text": "Capacitance is nominal. Typical DC-bias estimates and 65mV static reset margin do not prove load-transient behavior."
        },
        {
          "at": [
            15,
            187
          ],
          "text": "Integrated controller page. Native exported netlist checked against all PCB pins; unpowered and unrouted."
        }
      ]
    },
    {
      "id": "04-motor",
      "short_title": "Motor bridge",
      "title": "Smart Blinds / Motor bridge",
      "block_layout": "hw/schematics/blind-controller/motor-test.layout.json",
      "prefix": "motor",
      "source_prefix": "bridge",
      "notes": [
        {
          "at": [
            15.24,
            17.78
          ],
          "size": 2,
          "text": "MOTOR DRIVER / CIRCUIT STUDY"
        },
        {
          "at": [
            15.24,
            25.4
          ],
          "text": "DRV8874; 9\u201312.6 V pack; 3.3 V logic. Global nets connect controller and protection sheets."
        },
        {
          "at": [
            15.24,
            31.75
          ],
          "text": "Default off via pull-downs. IMODE floats deliberately: fixed off-time / latched overcurrent fault."
        },
        {
          "at": [
            20.32,
            43.18
          ],
          "text": "Control and status"
        },
        {
          "at": [
            198.12,
            43.18
          ],
          "text": "Supply and charge pump"
        },
        {
          "at": [
            15.24,
            101.6
          ],
          "text": "Default-off inputs / fault pull-up / PWM mode"
