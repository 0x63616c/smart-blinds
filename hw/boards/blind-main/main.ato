import ElectricPower
import Electrical

from "../blind-io/controller.ato" import ControllerIO
from "../blind-supervisor/supervisor.ato" import MotorSupervisor
from "../blind-controller/motor.ato" import MotorBridge
from "../blind-regen/regen.ato" import RegenerationClamp
from "../../parts/blind-power/AO3400A.ato" import Part_AO3400A
from "../../parts/blind-supervisor/SN74AUP1G97DCKR.ato" import Part_SN74AUP1G97DCKR
from "../../parts/blind-control-io/0402WGF1001TCE.ato" import Part_0402WGF1001TCE
from "../../parts/blind-controller-common/UNI_ROYAL_0402WGF1002TCE.ato" import UNI_ROYAL_0402WGF1002TCE_package
from "../../parts/blind-controller-common/SAMSUNG_CL05B104KB54PNC.ato" import SAMSUNG_CL05B104KB54PNC_package
from "../blind-usb/usb.ato" import UsbPdInput
from "../blind-charger/charger.ato" import Charger3S
from "../blind-regulator/regulator.ato" import LogicSupply
from "../blind-encoder/encoder.ato" import EncoderSupply
from "../blind-connectors/connector.ato" import ProtectedPackConnector
from "../blind-harness/harness.ato" import MotorSolderTails
from "../blind-harness/harness.ato" import EncoderConnector
from "../blind-harness/harness.ato" import HomeConnector
from "../../parts/blind-control-io/TPD2E2U06DRLR.ato" import Part_TPD2E2U06DRLR

module MainController:
    """INCOMPLETE integrated USB-C, charger, logic supply and motor controller.

    Battery input is the protected carrier output, never raw cell rails.
    Motor current bypasses charger SYS and is sensed by the carrier shunt.
    The powered USB PD controller shares the owned MCU/charger/gauge I2C bus.
    PD ALERT and charger INT share GPIO17 through one explicit 10k pull-up.
    Connectors and factory pads are still being added. NVM settings, layout and physical qualification remain mandatory.
    This unrouted capture must not be used to power hardware or fabricate.
    """
    controller = new ControllerIO
    supervision = new MotorSupervisor
    motor = new MotorBridge
    regen = new RegenerationClamp
    thermal_gate = new Part_SN74AUP1G97DCKR
    r_thermal_sleep = new Part_0402WGF1001TCE
    c_thermal_gate = new SAMSUNG_CL05B104KB54PNC_package
    usb = new UsbPdInput
    charger = new Charger3S
    logic_supply = new LogicSupply
    encoder = new EncoderSupply
    pack_connector = new ProtectedPackConnector
    motor_output = new MotorSolderTails
    encoder_port = new EncoderConnector
    home_port = new HomeConnector
    home_esd = new Part_TPD2E2U06DRLR
    battery = new ElectricPower
    battery.voltage = 9V to 12.6V
    battery ~ charger.battery
    battery ~ motor.pack
    battery ~ regen.pack
    usb.output ~ charger.source
    charger.system ~ logic_supply.source
    logic_supply.logic ~ usb.host_logic
    logic_supply.logic ~ controller.rail
    logic_supply.logic ~ supervision.rail
    logic_supply.logic ~ motor.logic
    logic_supply.logic ~ charger.logic
    charger.system ~ encoder.source
    logic_supply.logic ~ encoder.logic
    encoder.output ~ controller.encoder_rail
    encoder.allow_n ~ controller.encoder_allow_n
    encoder.reset_n ~ controller.reset_n
    usb.usb_dp ~ controller.usb_dp
    usb.usb_dn ~ controller.usb_dm
    controller.charge_allow_n ~ charger.allow_charge_n
    controller.power_interrupt_n ~ charger.irq_n
    controller.power_interrupt_n ~ usb.alert_n
    r_power_irq = new UNI_ROYAL_0402WGF1002TCE_package
    r_power_irq.1 ~ logic_supply.logic.hv
    r_power_irq.2 ~ controller.power_interrupt_n.line
    controller.i2c_sda.line ~ charger.sda
    controller.i2c_scl.line ~ charger.scl
    controller.i2c_sda ~ usb.host_bus.sda
    controller.i2c_scl ~ usb.host_bus.scl

    # External protected carrier telemetry and independent charger thermistor.
    # GPIO isolation/absent-pack behavior remains an integration test gate.
    pack_sda = new Electrical
    pack_scl = new Electrical
    pack_ntc = new Electrical
    pack_ntc_return = new Electrical
    pack_sda ~ charger.sda
    pack_scl ~ charger.scl
    pack_ntc ~ charger.ntc
    pack_ntc_return ~ charger.ntc_return
    pack_connector.pack_positive ~ battery.hv
    pack_connector.pack_ground ~ battery.lv
    pack_connector.gauge_sda ~ pack_sda
    pack_connector.gauge_scl ~ pack_scl
    pack_connector.charger_ntc ~ pack_ntc
    pack_connector.charger_ntc_return ~ pack_ntc_return

    controller.motor_request_n ~ supervision.motor_request_n
    controller.watchdog_heartbeat ~ supervision.heartbeat
    controller.reset_n ~ supervision.reset_n
    controller.motor_in1 ~ motor.in1
    controller.motor_in2 ~ motor.in2
    controller.motor_fault_n ~ motor.fault_n
    controller.current_raw ~ motor.current.line

    # Retained motor wires terminate in a keyed inline connector in the upper bay.
    # Encoder pinout/supply compatibility must be established on the owned motor.
    motor_output.motor1 ~ motor.motor_a
    motor_output.motor2 ~ motor.motor_b
    encoder_port.ground ~ battery.lv
    encoder_port.supply ~ encoder.output.hv
    encoder_port.channel_a ~ controller.encoder_a_raw
    encoder_port.channel_b ~ controller.encoder_b_raw

    # Dry contact only: home pin 2 is deliberately isolated/reserved, not powered.
    # Both independent ESD channels protect the one exposed sense conductor.
    home_port.ground ~ battery.lv
    home_port.sense ~ controller.home_contact_n
    home_esd.IO1 ~ controller.home_contact_n
    home_esd.IO2 ~ controller.home_contact_n
    home_esd.GND ~ battery.lv
    home_esd.NC1 ~ battery.lv
    home_esd.NC2 ~ battery.lv

    # Final independent AND: thermal permission AND supervised motor request.
    # AUP input tolerates the independent 3.3V rail with main VCC absent.
    # Missing PACK/local clamp supply therefore inhibits motion but not USB logic.
    thermal_gate.VCC ~ logic_supply.logic.hv
    thermal_gate.GND ~ battery.lv
    thermal_gate.IN0 ~ supervision.motor_sleep_n.line
    thermal_gate.IN1 ~ battery.lv
    thermal_gate.IN2 ~ regen.thermal_ok
    thermal_gate.Y ~ motor.awake.line
    r_thermal_sleep.1 ~ motor.awake.line
    r_thermal_sleep.2 ~ battery.lv
    c_thermal_gate.1 ~ logic_supply.logic.hv
    c_thermal_gate.2 ~ battery.lv

    # Share driver/thermal fault indication without joining local supply pullups.
    # The independently latched thermal-trip node drives only this MOSFET gate.
    q_thermal_fault = new Part_AO3400A
    q_thermal_fault.G ~ regen.thermal_trip_drive
    q_thermal_fault.S ~ battery.lv
    q_thermal_fault.D ~ motor.fault_n.line
