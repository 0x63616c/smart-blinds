"""
pd12v6 — USB-C PD (20 V) in, regulated 12.6 V / up to ~4.5 A out, USB 2.0 data passed through.

Design point (see docs/pd12v6/design.md for the full rationale):
  * CH224A asks the USB-C PD source for 20 V (CFG1 = 120 kΩ, single-resistor mode).
  * TPS54560 buck: 20 V -> 12.56 V, 400 kHz, 10 µH, non-synchronous (SS56 catch diode).
      FB divider 147 k / 10 k  ->  Vout = 0.8 V * (1 + 147/10) = 12.56 V
      RT = 240 k                ->  fsw ≈ 405 kHz   (RT = 101756 / f^1.008)
      UVLO 820 k / 56 k         ->  starts at ~17.8 V, stops at ~15.0 V
                                    (buck stays OFF on plain 5 V USB; only runs once PD 20 V is granted)
      Comp 20 k + 8.2 nF, 47 pF pole (datasheet §8.2.2.11 with Cout ≈ 56 µF derated)
  * Constant-current limit ≈ 4.5 A: 20 mΩ shunt in the output return, LM358 integrator
    injects current into FB when I_out > limit so a 65 W (3.25 A @ 20 V) charger is never overloaded.
      I_lim = (20 V * 1k / 221k) / 20 mΩ = 90 mV / 20 mΩ ≈ 4.5 A
  * LEDs: red  = PD 20 V negotiated (CH224A PG, active low)
          green = 12.6 V output present
  * Output: XT30PW-M (right angle, 15 A rated) + 1x3 2.54 mm header: D- , D+ , GND (USB 2.0 pass-through)
  * 4x M2 mounting holes (grounded), 2-layer, black solder mask.

This board knows nothing about what is downstream: it is just a PD-to-12.6 V supply.
"""

import Electrical
import has_net_name

from "parts/UNKNOWN_TYPE_C_31_M_12/UNKNOWN_TYPE_C_31_M_12.ato" import UNKNOWN_TYPE_C_31_M_12_package
from "parts/WCH_CH224A/WCH_CH224A.ato" import WCH_CH224A_package
from "parts/TI_TPS54560DDAR/TI_TPS54560DDAR.ato" import TI_TPS54560DDAR_package
from "parts/onsemi_LM358DR2G/onsemi_LM358DR2G.ato" import onsemi_LM358DR2G_package
from "parts/UNKNOWN_SL1040_100M/UNKNOWN_SL1040_100M.ato" import UNKNOWN_SL1040_100M_package
from "parts/MDD_SS56/MDD_SS56.ato" import MDD_SS56_package
from "parts/MDD_SMBJ24A/MDD_SMBJ24A.ato" import MDD_SMBJ24A_package
from "parts/CJ_1N4148W/CJ_1N4148W.ato" import CJ_1N4148W_package
from "parts/PSA_FMF25FPJR020_LH/PSA_FMF25FPJR020_LH.ato" import PSA_FMF25FPJR020_LH_package
from "parts/AMASS_XT30PW_M30_G_Y/AMASS_XT30PW_M30_G_Y.ato" import AMASS_XT30PW_M30_G_Y_package
from "parts/HCTL_PZ254_1_03_Z_8_5/HCTL_PZ254_1_03_Z_8_5.ato" import HCTL_PZ254_1_03_Z_8_5_package
from "parts/UNKNOWN_NCD0603G1/UNKNOWN_NCD0603G1.ato" import UNKNOWN_NCD0603G1_package
from "parts/KENTO_KT_0603R/KENTO_KT_0603R.ato" import KENTO_KT_0603R_package
from "parts/M2_HOLE/M2_HOLE.ato" import M2_HOLE

# capacitors
from "parts/TORCH_CC1210X7R50V106KN/TORCH_CC1210X7R50V106KN.ato" import TORCH_CC1210X7R50V106KN_package          # 10 µF 50 V X7R 1210
from "parts/Chinocera_HGC1210R5476M250NSVK/Chinocera_HGC1210R5476M250NSVK.ato" import Chinocera_HGC1210R5476M250NSVK_package  # 47 µF 25 V X5R 1210
from "parts/SAMSUNG_CL10A105KB8NNNC/SAMSUNG_CL10A105KB8NNNC.ato" import SAMSUNG_CL10A105KB8NNNC_package          # 1 µF 50 V 0603
from "parts/YAGEO_CC0603KRX7R9BB104/YAGEO_CC0603KRX7R9BB104.ato" import YAGEO_CC0603KRX7R9BB104_package          # 100 nF 50 V 0603
from "parts/muRata_GRM1885C1H822JA01D/muRata_GRM1885C1H822JA01D.ato" import muRata_GRM1885C1H822JA01D_package    # 8.2 nF C0G 0603
from "parts/FH_0603CG470J500NT/FH_0603CG470J500NT.ato" import FH_0603CG470J500NT_package                          # 47 pF C0G 0603

# resistors (0603, 1 %)
from "parts/UNI_ROYAL_0603WAF1001T5E/UNI_ROYAL_0603WAF1001T5E.ato" import UNI_ROYAL_0603WAF1001T5E_package  # 1 k
from "parts/UNI_ROYAL_0603WAF4701T5E/UNI_ROYAL_0603WAF4701T5E.ato" import UNI_ROYAL_0603WAF4701T5E_package  # 4.7 k
from "parts/UNI_ROYAL_0603WAF1002T5E/UNI_ROYAL_0603WAF1002T5E.ato" import UNI_ROYAL_0603WAF1002T5E_package  # 10 k
from "parts/UNI_ROYAL_0603WAF2002T5E/UNI_ROYAL_0603WAF2002T5E.ato" import UNI_ROYAL_0603WAF2002T5E_package  # 20 k
from "parts/UNI_ROYAL_0603WAF5602T5E/UNI_ROYAL_0603WAF5602T5E.ato" import UNI_ROYAL_0603WAF5602T5E_package  # 56 k
from "parts/UNI_ROYAL_0603WAF1003T5E/UNI_ROYAL_0603WAF1003T5E.ato" import UNI_ROYAL_0603WAF1003T5E_package  # 100 k
from "parts/UNI_ROYAL_0603WAF1203T5E/UNI_ROYAL_0603WAF1203T5E.ato" import UNI_ROYAL_0603WAF1203T5E_package  # 120 k
from "parts/UNI_ROYAL_0603WAF1473T5E/UNI_ROYAL_0603WAF1473T5E.ato" import UNI_ROYAL_0603WAF1473T5E_package  # 147 k
from "parts/UNI_ROYAL_0603WAF2203T5E/UNI_ROYAL_0603WAF2203T5E.ato" import UNI_ROYAL_0603WAF2203T5E_package  # 220 k
from "parts/UNI_ROYAL_0603WAF2403T5E/UNI_ROYAL_0603WAF2403T5E.ato" import UNI_ROYAL_0603WAF2403T5E_package  # 240 k
from "parts/UNI_ROYAL_0603WAF8203T5E/UNI_ROYAL_0603WAF8203T5E.ato" import UNI_ROYAL_0603WAF8203T5E_package  # 820 k


module App:
    # ------------------------------------------------------------------ nets
    signal gnd        # board ground (USB-C shell/GND, input side)
    signal vbus       # USB-C VBUS, 5 V at plug-in then 20 V after PD negotiation
    signal vout       # 12.56 V regulated output
    signal out_rtn    # output return; sits I_out * 20 mΩ above gnd (current sense)
    signal usb_dp
    signal usb_dn
    signal cc1
    signal cc2
    signal pg_n       # CH224A PowerGood, open-drain, LOW when 20 V granted
    signal en         # TPS54560 EN / UVLO divider tap
    signal boot
    signal sw
    signal fb
    signal comp
    signal comp_z     # between comp resistor and zero capacitor
    signal rt
    signal cfg1
    signal i_ref      # ≈ 90 mV current-limit reference
    signal i_sense    # filtered shunt voltage
    signal i_int      # LM358 inverting input / integrator node
    signal i_out      # LM358 output
    signal i_inj      # after 100 k, before injection diode
    signal led_pd_k
    signal led_out_k

    # explicit net names (otherwise atopile picks a pad number such as "1")
    trait gnd has_net_name<name="GND">
    trait vbus has_net_name<name="VBUS">
    trait vout has_net_name<name="VOUT">
    trait out_rtn has_net_name<name="OUT_RTN">
    trait usb_dp has_net_name<name="USB_DP">
    trait usb_dn has_net_name<name="USB_DN">
    trait cc1 has_net_name<name="CC1">
    trait cc2 has_net_name<name="CC2">
    trait pg_n has_net_name<name="PG_n">
    trait en has_net_name<name="EN">
    trait boot has_net_name<name="BOOT">
    trait sw has_net_name<name="SW">
    trait fb has_net_name<name="FB">
    trait comp has_net_name<name="COMP">
    trait comp_z has_net_name<name="COMP_Z">
    trait rt has_net_name<name="RT">
    trait cfg1 has_net_name<name="CFG1">
    trait i_ref has_net_name<name="I_REF">
    trait i_sense has_net_name<name="I_SENSE">
    trait i_int has_net_name<name="I_INT">
    trait i_out has_net_name<name="I_OUT">
    trait i_inj has_net_name<name="I_INJ">
    trait led_pd_k has_net_name<name="LED_PD_K">
    trait led_out_k has_net_name<name="LED_OUT_K">

    # ------------------------------------------------------------------ USB-C input
    usb = new UNKNOWN_TYPE_C_31_M_12_package     # TYPE-C-31-M-12, 16-pin, mid-mount style, C165948
    usb.VBUS ~ vbus
    usb.GND ~ gnd
    usb.EH ~ gnd                                  # shell
    usb.CC1 ~ cc1
    usb.CC2 ~ cc2
    usb.DP1 ~ usb_dp
    usb.DP2 ~ usb_dp
    usb.DN1 ~ usb_dn
    usb.DN2 ~ usb_dn
    # SBU1/SBU2 intentionally unconnected

    tvs = new MDD_SMBJ24A_package                 # 24 V standoff TVS on VBUS (hot-plug transients)
    tvs.C ~ vbus
    tvs.A ~ gnd

    # ------------------------------------------------------------------ PD sink controller
    pd = new WCH_CH224A_package                   # CH224A, ESSOP-10, C42459160
    pd.VHV ~ vbus
    pd.VBUS ~ vbus                                # datasheet: VBUS "needs to be shorted to VHV"
    pd.GND ~ gnd
    pd.CC1 ~ cc1
    pd.CC2 ~ cc2
    pd.CFG1 ~ cfg1
    pd.PG ~ pg_n
    # CFG2/CFG3 float (single-resistor mode), DP/DM unused (data is passed straight through)

    c_vhv = new SAMSUNG_CL10A105KB8NNNC_package   # 1 µF on VHV (datasheet table 4-1)
    c_vhv.1 ~ vbus
    c_vhv.2 ~ gnd

    r_cfg1 = new UNI_ROYAL_0603WAF1203T5E_package # 120 k -> request 20 V (datasheet table 5-1)
    r_cfg1.1 ~ cfg1
    r_cfg1.2 ~ gnd

    led_pd = new KENTO_KT_0603R_package           # red: "PD 20 V negotiated"
    r_led_pd = new UNI_ROYAL_0603WAF1002T5E_package  # 10 k  -> ~1.8 mA
    led_pd.A ~ vbus
    led_pd.K ~ led_pd_k
    r_led_pd.1 ~ led_pd_k
    r_led_pd.2 ~ pg_n

    # ------------------------------------------------------------------ buck 20 V -> 12.56 V
    buck = new TI_TPS54560DDAR_package            # TPS54560DDAR, SO-8 PowerPAD, C31966
    buck.VIN ~ vbus
    buck.GND ~ gnd
    buck.EP ~ gnd
    buck.EN ~ en
    buck.BOOT ~ boot
    buck.SW ~ sw
    buck.FB ~ fb
    buck.COMP ~ comp
    buck.RT_CLK ~ rt

    # input capacitors: 2 x 10 µF 50 V X7R 1210 + 100 nF close to VIN
    c_in1 = new TORCH_CC1210X7R50V106KN_package
    c_in2 = new TORCH_CC1210X7R50V106KN_package
    c_in_hf = new YAGEO_CC0603KRX7R9BB104_package
    c_in1.1 ~ vbus
    c_in1.2 ~ gnd
    c_in2.1 ~ vbus
    c_in2.2 ~ gnd
    c_in_hf.1 ~ vbus
    c_in_hf.2 ~ gnd

    # UVLO: 820 k / 56 k -> start 17.8 V, stop 15.0 V (datasheet eq. 4/5, Ihys 3.4 µA, I1 1.2 µA)
    r_uvlo1 = new UNI_ROYAL_0603WAF8203T5E_package
    r_uvlo2 = new UNI_ROYAL_0603WAF5602T5E_package
    r_uvlo1.1 ~ vbus
    r_uvlo1.2 ~ en
    r_uvlo2.1 ~ en
    r_uvlo2.2 ~ gnd

    # switching frequency: 240 k -> ~405 kHz
    r_rt = new UNI_ROYAL_0603WAF2403T5E_package
    r_rt.1 ~ rt
    r_rt.2 ~ gnd

    # bootstrap 100 nF BOOT-SW
    c_boot = new YAGEO_CC0603KRX7R9BB104_package
    c_boot.1 ~ boot
    c_boot.2 ~ sw

    # catch diode + inductor
    d_catch = new MDD_SS56_package                # SS56 5 A / 60 V Schottky, SMA
    d_catch.K ~ sw
    d_catch.A ~ gnd

    l_out = new UNKNOWN_SL1040_100M_package       # 10 µH, 7.5 A, 10x10 mm shielded
    l_out.1 ~ sw
    l_out.2 ~ vout

    # output capacitors: 2 x 47 µF 25 V X5R 1210
    c_out1 = new Chinocera_HGC1210R5476M250NSVK_package
    c_out2 = new Chinocera_HGC1210R5476M250NSVK_package
    c_out1.1 ~ vout
    c_out1.2 ~ gnd
    c_out2.1 ~ vout
    c_out2.2 ~ gnd

    # feedback divider: 147 k / 10 k -> 12.56 V
    r_fb_hi = new UNI_ROYAL_0603WAF1473T5E_package
    r_fb_lo = new UNI_ROYAL_0603WAF1002T5E_package
    r_fb_hi.1 ~ vout
    r_fb_hi.2 ~ fb
    r_fb_lo.1 ~ fb
    r_fb_lo.2 ~ gnd

    # compensation: 20 k + 8.2 nF (zero), 47 pF (pole)
    r_comp = new UNI_ROYAL_0603WAF2002T5E_package
    c_comp_z = new muRata_GRM1885C1H822JA01D_package
    c_comp_p = new FH_0603CG470J500NT_package
    r_comp.1 ~ comp
    r_comp.2 ~ comp_z
    c_comp_z.1 ~ comp_z
    c_comp_z.2 ~ gnd
    c_comp_p.1 ~ comp
    c_comp_p.2 ~ gnd

    # ------------------------------------------------------------------ output
    out = new AMASS_XT30PW_M30_G_Y_package        # XT30PW-M right-angle, C431092
    out.pos ~ vout
    out.neg ~ out_rtn

    r_shunt = new PSA_FMF25FPJR020_LH_package     # 20 mΩ 2 W 2512, in the output return
    r_shunt.1 ~ out_rtn
    r_shunt.2 ~ gnd

    data = new HCTL_PZ254_1_03_Z_8_5_package      # 1x3 2.54 mm header: D- D+ GND
    data.1 ~ usb_dn                               # pin 1 (square pad) = D-
    data.2 ~ usb_dp
    data.3 ~ out_rtn                              # same reference as the output negative

    led_out = new UNKNOWN_NCD0603G1_package       # green: "12.6 V present"
    r_led_out = new UNI_ROYAL_0603WAF4701T5E_package  # 4.7 k -> ~2.2 mA
    led_out.A ~ vout
    led_out.K ~ led_out_k
    r_led_out.1 ~ led_out_k
    r_led_out.2 ~ gnd

    # ------------------------------------------------------------------ constant-current limit (~4.5 A)
    opamp = new onsemi_LM358DR2G_package          # LM358, powered from VBUS (20 V)
    opamp.VCC ~ vbus
    opamp.GND ~ gnd
    c_opamp = new YAGEO_CC0603KRX7R9BB104_package
    c_opamp.1 ~ vbus
    c_opamp.2 ~ gnd

    # reference: VBUS * 1k / (220k + 1k) ≈ 90 mV
    r_ref_hi = new UNI_ROYAL_0603WAF2203T5E_package
    r_ref_lo = new UNI_ROYAL_0603WAF1001T5E_package
    r_ref_hi.1 ~ vbus
    r_ref_hi.2 ~ i_ref
    r_ref_lo.1 ~ i_ref
    r_ref_lo.2 ~ gnd

    # shunt sense filter: 1 k + 100 nF
    r_sense = new UNI_ROYAL_0603WAF1001T5E_package
    c_sense = new YAGEO_CC0603KRX7R9BB104_package
    r_sense.1 ~ out_rtn
    r_sense.2 ~ i_sense
    c_sense.1 ~ i_sense
    c_sense.2 ~ gnd

    # integrator: + = sense, - = ref via 10 k, 100 nF feedback
    opamp.P1INpos ~ i_sense
    opamp.P1INneg ~ i_int
    opamp.P1OUT ~ i_out
    r_int = new UNI_ROYAL_0603WAF1002T5E_package
    c_int = new YAGEO_CC0603KRX7R9BB104_package
    r_int.1 ~ i_ref
    r_int.2 ~ i_int
    c_int.1 ~ i_out
    c_int.2 ~ i_int

    # injection into FB: 100 k series limits FB to < 3 V abs-max even with the op-amp railed
    r_inj = new UNI_ROYAL_0603WAF1003T5E_package
    d_inj = new CJ_1N4148W_package
    r_inj.1 ~ i_out
    r_inj.2 ~ i_inj
    d_inj.A ~ i_inj
    d_inj.K ~ fb

    # unused second op-amp: follower with input grounded
    opamp.P2INpos ~ gnd
    opamp.P2INneg ~ opamp.P2OUT

    # ------------------------------------------------------------------ mechanical
    h1 = new M2_HOLE
    h2 = new M2_HOLE
    h3 = new M2_HOLE
    h4 = new M2_HOLE
    h1.contact ~ gnd
    h2.contact ~ gnd
    h3.contact ~ gnd
    h4.contact ~ gnd
